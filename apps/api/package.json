{
  "name": "@centinela/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de CENTINELA: NestJS 11, cola BullMQ sobre Redis y alertas en vivo por Socket.IO.",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
